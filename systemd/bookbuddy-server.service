[Unit]
Description=Book Buddy server (web page, HTTP API and the job queue worker, localhost only)
After=default.target

[Service]
Type=simple
# install-server.sh replaces @BOOKBUDDY@ with the absolute path of your `bookbuddy` executable.
# Listens on 127.0.0.1 only. To listen elsewhere add `--host ADDRESS --token SECRET` (a token is required off localhost).
ExecStart=@BOOKBUDDY@ serve
Restart=on-failure
RestartSec=30
Nice=10
Environment=PYTHONUNBUFFERED=1
# Stopping the server pauses a running book; it resumes on the next start.
TimeoutStopSec=60

[Install]
WantedBy=default.target
